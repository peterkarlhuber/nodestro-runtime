  "jwt": [
    {"id": "jwt-valid-rs256", "header": {"alg": "RS256", "kid": "rsa-a", "typ": "JWT"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "accept"},
    {"id": "jwt-valid-ps256", "header": {"alg": "PS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "accept"},
    {"id": "jwt-valid-es256", "header": {"alg": "ES256", "kid": "ec-p256"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "ec-p256", "expect": "accept"},
    {"id": "jwt-valid-eddsa", "header": {"alg": "EdDSA", "kid": "ed25519"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "ed25519", "expect": "accept"},
    {"id": "jwt-valid-audience-list-with-azp", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": ["@client_id", "other-client"], "azp": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "accept"},
    {"id": "jwt-valid-exp-within-leeway", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now-300", "exp": "@now-30", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "accept"},
    {"id": "jwt-alg-none", "header": {"alg": "none"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "none", "expect": "reject"},
    {"id": "jwt-alg-hs256-public-key", "header": {"alg": "HS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "hmac-rsa-a-public", "expect": "reject"},
    {"id": "jwt-alg-hs256-shared-secret", "header": {"alg": "HS256"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "hmac-shared", "expect": "reject"},
    {"id": "jwt-alg-key-type-mismatch", "header": {"alg": "ES256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "ec-p256", "expect": "reject"},
    {"id": "jwt-unknown-kid", "header": {"alg": "RS256", "kid": "rsa-unpublished"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-unpublished", "expect": "reject"},
    {"id": "jwt-foreign-key-known-kid", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-unpublished", "expect": "reject"},
    {"id": "jwt-bad-signature", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "tamper": "signature", "expect": "reject"},
    {"id": "jwt-expired", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now-400", "exp": "@now-300", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
    {"id": "jwt-not-yet-valid", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now", "nbf": "@now+3600", "exp": "@now+7200", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
    {"id": "jwt-issued-in-the-future", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "iat": "@now+3600", "exp": "@now+7200", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
