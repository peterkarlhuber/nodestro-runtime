{
  "name": "security-vectors",
  "version": 1,
  "description": "Shared security test vectors for outbound address checks (egress), OpenID Connect ID token checks (jwt) and secret redaction (redaction). Canonical file; every consumer keeps a checksummed copy. Maintenance and field reference: tests/vectors/README.md in nodestro-runtime.",
  "conventions": {
    "egress": "address: an IP literal, judged by the platform's address check alone. url: a target as an operator configures it, judged by the static URL checks and then by the address check of every DNS answer; resolves_to lists the answers of a fake resolver (no network). A host without resolves_to that is no IP literal resolves as the C library does for numeric hosts (inet_aton: 2130706433, 0x7f.1, 0177.0.0.1, 127.1). expect: block or allow.",
    "jwt": "Each vector is one ID token for the context in jwt_context. Claim values '@issuer', '@client_id' and '@nonce' stand for the context values; '@now', '@now+N' and '@now-N' for the current Unix time plus or minus N seconds; a list is resolved item by item. key_ref names a key the test generates (key_refs below); tamper 'signature' changes one byte of a valid signature. expect: accept or reject.",
    "redaction": "input is a string or a JSON object handed to the platform's credential redaction; none of the strings in must_not_contain may appear anywhere in the result.",
    "known_differences": "A documented deviation of one platform from a vector's expectation: category, id, platform, the actual verdict (egress: block or allow; jwt: accept or reject; redaction: not_redacted) and the reason. A platform's test asserts the actual verdict, so a fixed difference fails until its entry is removed."
  },
  "jwt_context": {
    "issuer": "https://idp.vectors.test",
    "client_id": "vector-client",
    "nonce": "vector-nonce-5f1c",
    "leeway_seconds": 60,
    "max_age_seconds": 600,
    "key_refs": {
      "rsa-a": "RSA 2048, published in the provider's key set with kid rsa-a",
      "ec-p256": "EC P-256, published with kid ec-p256",
      "ed25519": "Ed25519, published with kid ed25519",
      "rsa-unpublished": "RSA 2048, generated but not in the provider's key set",
      "hmac-shared": "a random 32-byte shared secret (HMAC), never in the key set",
      "hmac-rsa-a-public": "HMAC keyed with rsa-a's public key in PEM form (algorithm confusion)",
      "none": "no signature (alg none)"
    }
  },
