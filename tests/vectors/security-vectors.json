  "known_differences": [
    {"category": "egress", "id": "egress-v6-nat64-public", "platform": "nodestro", "actual": "allow", "reason": "Nodestro judges a NAT64 address (64:ff9b::/96) by the IPv4 address it embeds: on an IPv6-only desktop or server behind DNS64 every public IPv4 MCP server resolves to such an address, so refusing the prefix would cut those hosts off. Internal embedded addresses are still refused (egress-v6-nat64-loopback, -private, -metadata). Axentra refuses the prefix (it lies in ::/8, reserved), the stricter choice for webhooks sent from a server."},
    {"category": "egress", "id": "egress-v6-6to4-public", "platform": "nodestro", "actual": "allow", "reason": "Nodestro judges a 6to4 address by the IPv4 address it embeds, checked explicitly and independent of the Python patch level, so 6to4 to a public IPv4 host reaches only that public host; internal embedded addresses are refused (egress-v6-6to4-loopback, -private, -metadata). Axentra refuses the whole deprecated prefix, the stricter choice for webhooks (MUP-ONA A4)."},
    {"category": "egress", "id": "egress-url-query-token", "platform": "axentra", "actual": "allow", "reason": "Axentra accepts a webhook URL with a token in its query: receivers commonly authenticate that way, the payload is signed separately, and the URL is redacted in audit details (redact_text). Nodestro refuses a credential in an MCP server address because addresses are stored and shown in the clear and keys belong in the sealed token (ADR-0007 D-3)."},
    {"category": "redaction", "id": "redact-key-session-id", "platform": "axentra", "actual": "not_redacted", "reason": "Axentra's session_id values are session row ids (ses_...), not credentials: the session token is a separate random value that is stored only as a hash and redacted by its cookie name (axentra-session). Nodestro removes every value under a session_id key because its traces can hold other services' session ids."},
    {"category": "redaction", "id": "redact-pem-private-key", "platform": "axentra", "actual": "not_redacted", "reason": "Axentra never handles private keys (it terminates no TLS, and OIDC clients authenticate with a client secret or PKCE only), so its log redaction has no PEM pattern. Nodestro's trace export carries tool inputs and outputs that can contain any key."},
    {"category": "redaction", "id": "redact-anthropic-key", "platform": "axentra", "actual": "not_redacted", "reason": "LLM provider API keys are Nodestro's credentials (model calls); Axentra never receives them, so its redaction covers its own formats (axk_, axinv_, whsec_) and generic bearer tokens, JWTs, Basic credentials, cookies, passwords and client secrets."},
    {"category": "redaction", "id": "redact-aws-access-key-id", "platform": "axentra", "actual": "not_redacted", "reason": "An AWS access key id is an identifier, not a secret; Axentra's S3 credentials come from secret references and go only to boto3, which does not log them. Nodestro removes access key ids because its traces can hold users' own AWS keys next to their secret parts."},
    {"category": "redaction", "id": "redact-github-token", "platform": "axentra", "actual": "not_redacted", "reason": "GitHub tokens appear in Nodestro's tool calls and integrations; Axentra never handles them, so its redaction covers its own formats (axk_, axinv_, whsec_) and generic bearer tokens, JWTs, Basic credentials, cookies, passwords and client secrets."},
    {"category": "redaction", "id": "redact-api-key-assignment", "platform": "axentra", "actual": "not_redacted", "reason": "Axentra's API keys carry the axk_ prefix and are redacted by that format wherever they appear, and mapping keys named api_key are redacted; a free-text api_key=... assignment holds no Axentra credential. Nodestro's traces can hold any service's key in such an assignment."},
    {"category": "redaction", "id": "redact-webhook-signing-secret", "platform": "nodestro", "actual": "not_redacted", "reason": "whsec_ is the format of Axentra's webhook signing secrets; Nodestro's runs and traces never hold them (Nodestro neither creates nor delivers Axentra webhooks), so its trace sanitizer has no pattern for that format."}
  ]
