    {"id": "jwt-missing-iat", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "user-1", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
    {"id": "jwt-missing-aud", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "sub": "user-1", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
    {"id": "jwt-missing-sub", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
    {"id": "jwt-empty-sub", "header": {"alg": "RS256", "kid": "rsa-a"}, "claims": {"iss": "@issuer", "aud": "@client_id", "sub": "", "iat": "@now", "exp": "@now+600", "nonce": "@nonce"}, "key_ref": "rsa-a", "expect": "reject"},
